DATABASE_URL="file:../data/app.db"
# Production (Netlify): use a hosted DB — local SQLite will not work.
# Example Turso: DATABASE_URL="libsql://YOUR-DB.turso.io" + TURSO auth if used
# Example Supabase Postgres: DATABASE_URL="postgresql://postgres:...@db.xxx.supabase.co:5432/postgres"

# Required to identify items and estimate prices
OPENAI_API_KEY=

# Optional. Session signing secret (defaults to a dev value).
# On Netlify, set a long random SESSION_SECRET.
SESSION_SECRET=

# Optional. Google Images search for part photos (serpapi.com free tier).
SERPAPI_KEY=
# Defaults: email grossmanshimon1@gmail.com, password inventorymommy (or APP_PASSWORD if set).
OWNER_EMAIL=
OWNER_PASSWORD=

# Legacy single shared password (no longer used for login after accounts migrate).
APP_PASSWORD=

# Supabase (phone capture + live photo sync + eBay photo export)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL on Netlify (e.g. https://your-site.netlify.app)
NEXT_PUBLIC_APP_URL=
