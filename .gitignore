# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local catalog data
/data/*
!/data/.gitkeep
!/data/uploads/
/data/uploads/*
!/data/uploads/.gitkeep

# vercel
.vercel

# expo leftovers / local caches
.expo/

# generated part photos (recreated by the app)
/public/part-images/*
!/public/part-images/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
